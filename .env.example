# =============================================================================
# MonPetitBiz WhatsApp Bot - Environment Configuration
# =============================================================================
# Copy this file to .env and update the values for your environment
# See docs/environment-variables.md for detailed documentation

# =============================================================================
# DATABASE CONFIGURATION (Required)
# =============================================================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_secure_database_password
DATABASE_NAME=monpetitbiz

# =============================================================================
# JWT AUTHENTICATION (Required)
# =============================================================================
# Generate a strong secret key (minimum 32 characters)
JWT_SECRET=your-super-secure-jwt-secret-key-at-least-32-characters-long
JWT_EXPIRES_IN=7d

# =============================================================================
# TWILIO WHATSAPP INTEGRATION (Required - Primary Provider)
# =============================================================================
# Get these credentials from Twilio Console: https://console.twilio.com/
# Navigate to: Account > API Keys & Tokens

# Core Twilio Credentials (Required)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890

# Webhook Security (Highly Recommended)
# Generate a strong random string for webhook signature verification
TWILIO_WEBHOOK_SECRET=your-strong-webhook-secret-32-characters-minimum

# Optional Twilio Configuration
TWILIO_ENVIRONMENT=production  # Options: 'production' or 'sandbox'
TWILIO_RETRY_ATTEMPTS=3        # Number of retry attempts for failed API calls
TWILIO_TIMEOUT=30000          # API timeout in milliseconds (30 seconds)

# =============================================================================
# WHATSAPP PROVIDER CONFIGURATION (Required)
# =============================================================================
# Primary provider configuration
WHATSAPP_PRIMARY_PROVIDER=twilio           # Options: 'twilio' or 'meta'
WHATSAPP_ENABLE_TWILIO_SENDING=true        # Enable Twilio for sending messages
WHATSAPP_ENABLE_TWILIO_WEBHOOKS=true       # Enable Twilio webhook processing

# Dual provider settings (Optional)
WHATSAPP_FALLBACK_ENABLED=false            # Enable fallback to secondary provider
WHATSAPP_HEALTH_CHECK_INTERVAL=300000      # Health check interval (5 minutes)

# =============================================================================
# META WHATSAPP API (Optional - Fallback Only)
# =============================================================================
# Only configure these if you want Meta API as fallback during migration
# Get these from Meta Developer Console: https://developers.facebook.com/apps/
# Uncomment and configure only if needed for fallback

# WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token
# WHATSAPP_APP_SECRET=your_app_secret
# WHATSAPP_ENABLE_META_FALLBACK=false

# Supabase Storage (Optional — required for PDF report upload in production)
# Create a bucket (e.g. "reports") in Supabase Dashboard > Storage; use the service role key only on the server.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=reports

# Application Configuration
PORT=3000
NODE_ENV=development

# HTTPS Configuration
USE_HTTPS=false
SSL_KEY_PATH=ssl/private-key.pem
SSL_CERT_PATH=ssl/certificate.pem

# Frontend Configuration (for CORS)
FRONTEND_URL=http://localhost:3001

# Optional: Redis Configuration (for production message queue)
# REDIS_URL=redis://localhost:6379

# Optional: Logging Configuration
# LOG_LEVEL=debug
# LOG_FILE=logs/app.log

# Optional: Rate Limiting
# RATE_LIMIT_TTL=60
# RATE_LIMIT_LIMIT=100

# Optional: Webhook Security
# WEBHOOK_TIMEOUT=30000
# MAX_WEBHOOK_RETRIES=3