{
  "name": "monpetitbiz",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "vercel-build": "npm run build",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "node --localstorage-file=./.jest-localstorage.json node_modules/.bin/jest",
    "test:watch": "node --localstorage-file=./.jest-localstorage.json node_modules/.bin/jest --watch",
    "test:cov": "node --localstorage-file=./.jest-localstorage.json node_modules/.bin/jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config test/jest-e2e.json --forceExit",
    "test:integration": "jest --testPathPattern=integration.spec.ts --runInBand --forceExit",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm -- migration:generate -d src/config/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/config/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/config/data-source.ts",
    "seed": "ts-node src/database/seed.ts",
    "quick-start": "./scripts/quick-start.sh",
    "setup-db": "./scripts/setup-database.sh",
    "setup-twilio": "./scripts/setup-twilio.sh",
    "test-api": "node test-api.js",
    "test-otp-integration": "node test-otp.js",
    "test-otp-mock": "node test-otp-mock.js",
    "generate:ssl": "./scripts/generate-ssl-cert.sh",
    "start:https": "USE_HTTPS=true npm run start:dev",
    "start:https:prod": "USE_HTTPS=true npm run start:prod",
    "test:https": "USE_HTTPS=true node test-https.js",
    "test:http": "USE_HTTPS=false node test-https.js",
    "test:twilio": "node test-twilio-webhook.js",
    "test:twilio-webhooks": "node scripts/test-twilio-webhooks.js",
    "migration:validate": "ts-node src/modules/whatsapp/cli/migration-validator.cli.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.19",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/typeorm": "^11.0.0",
    "@supabase/supabase-js": "^2.105.4",
    "@types/express": "^5.0.3",
    "@types/uuid": "^9.0.8",
    "@vercel/speed-insights": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "express": "^5.1.0",
    "handlebars": "^4.7.8",
    "pg": "^8.16.3",
    "puppeteer": "^24.23.0",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.10.3",
    "typeorm": "^0.3.27",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.14",
    "@nestjs/testing": "^11.1.19",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.7.0",
    "@types/pg": "^8.15.5",
    "@types/puppeteer": "^5.4.7",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "sqlite3": "^5.1.7",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vercel": "^53.3.2"
  },
  "overrides": {
    "tar": "^7.5.15",
    "@tootallnate/once": "^3.0.1",
    "http-proxy-agent": "^7.0.2",
    "undici": "^6.25.0",
    "ajv": "^8.17.1",
    "minimatch": "^10.2.5",
    "smol-toml": "^1.6.1",
    "srvx": "^0.11.15",
    "@vercel/fun": {
      "@tootallnate/once": "^3.0.1",
      "path-to-regexp": "^8.4.2"
    },
    "@vercel/node": {
      "path-to-regexp": "^6.3.0"
    },
    "@vercel/remix-builder": {
      "path-to-regexp": "^6.3.0"
    },
    "@vercel/introspection": {
      "path-to-regexp": "^6.3.0"
    },
    "router": {
      "path-to-regexp": "^8.4.2"
    },
    "@vercel/backends": {
      "path-to-regexp": "^8.4.2"
    },
    "@vercel/hono": {
      "path-to-regexp": "^8.4.2"
    },
    "@vercel/express": {
      "path-to-regexp": "^8.4.2"
    }
  }
}
